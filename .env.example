# Copiar a .env y rellenar. .env NUNCA se sube al repositorio.

PORT=3000
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Solo para tareas de servidor (seed, migraciones). Se salta las políticas RLS:
# jamás la expongas al navegador ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Número de WhatsApp del negocio que recibe los pedidos (formato internacional
# sin + ni espacios). Ej: 573170237977
WHATSAPP_NUMERO=573170237977
