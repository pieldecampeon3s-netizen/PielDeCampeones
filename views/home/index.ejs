<style>
        .size-chart-wrapper {
            background: rgba(255,255,255,0.08);
            border-radius: 20px;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100%;
            box-shadow: 0 15px 40px rgba(0,0,0,.25);
        }

        .size-chart-img {
            width: 100%;
            max-width: 650px;
            border-radius: 15px;
            transition: .3s ease;
        }

            .size-chart-img:hover {
                transform: scale(1.02);
            }
        /* VARIABLES GLOBALES */
        :root {
            --color-primario: #d9b04a;
            --color-fondo-oscuro: #000000;
            --ease-out-quint: cubic-bezier(0.23, 1, 0.32, 1);
        }

        .section-title {
            text-align: center;
            margin-bottom: 4rem;
            font-weight: 800;
            position: relative;
        }

            .section-title::after {
                content: '';
                display: block;
                width: 70px;
                height: 4px;
                background-color: var(--color-primario);
                margin: 10px auto 0;
            }

        /* ESTILOS PARA SECCIÓN 1: HERO CON BÚSQUEDA */
        .hero-search-section {
            position: relative;
            height: 90vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            overflow: hidden;
        }

        .video-background-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #121212;
        }

            /* <picture> es inline por defecto: sin esto no llena el contenedor */
            .video-background-container picture {
                display: block;
                width: 100%;
                height: 100%;
            }

        .hero-image {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

        .video-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0.2));
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .vehicle-finder-v2 {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            padding: 1.5rem;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 1rem;
            max-width: 900px;
            margin: 0 auto;
        }

            .vehicle-finder-v2 .form-label {
                display: none;
            }

            .vehicle-finder-v2 .form-select, .vehicle-finder-v2 .btn {
                border: none;
            }

        .find-parts-btn {
            background-color: var(--color-primario);
            color: white;
            font-weight: 600;
        }
        
        /* =======================================================
           ESTILOS PARA TARJETAS DE CATEGORÍA PROFESIONALES
           ======================================================= */

        /* --- Base de la Tarjeta --- */
        .category-card-pro {
            display: block;
            position: relative;
            overflow: hidden;
            height: 300px; /* Altura uniforme para las tarjetas */
            border-radius: 12px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            text-decoration: none;
            transition: box-shadow 0.3s ease;
        }

            .category-card-pro:hover {
                box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25);
            }

            /* --- Capa de Imagen con Efecto Zoom --- */
            .category-card-pro::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: inherit; /* Hereda el background-image del inline style */
                background-size: cover;
                background-position: center;
                transition: transform 0.4s ease-out;
                z-index: 1;
            }

            .category-card-pro:hover::before {
                transform: scale(1.08); /* Sutil zoom al pasar el cursor */
            }

            /* --- Overlay de Gradiente para Legibilidad --- */
            .category-card-pro::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                /* Gradiente oscuro abajo que se desvanece hacia arriba */
                background: linear-gradient(to top, rgba(10, 10, 10, 0.9) 0%, rgba(10, 10, 10, 0.7) 25%, transparent 60%);
                z-index: 2;
                transition: background 0.3s ease;
            }

            /* --- Contenido de Texto --- */
            .category-card-pro .card-content {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                padding: 25px 30px;
                z-index: 3; /* Siempre al frente */
                color: #ffffff;
                transition: transform 0.35s ease-out;
            }

            .category-card-pro:hover .card-content {
                transform: translateY(-10px); /* Eleva el texto sutilmente */
            }

            /* --- Tipografía Premium --- */
            .category-card-pro h3 {
                font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
                font-size: 1.8rem;
                font-weight: 700;
                margin: 0 0 5px 0;
                /* Sombra sutil que despega el texto del fondo */
                text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.6);
            }

            .category-card-pro p {
                font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
                font-size: 1rem;
                margin: 0;
                color: rgba(255, 255, 255, 0.85);
                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.6);
            }

            /* --- Ícono de Acción --- */
            .category-card-pro .card-action {
                position: absolute;
                top: 25px;
                right: 30px;
                z-index: 3;
                font-size: 2.2rem;
                color: rgba(255, 255, 255, 0.7);
                opacity: 0; /* Oculto por defecto */
                transform: translateX(15px);
                transition: opacity 0.4s ease, transform 0.4s ease;
            }

            .category-card-pro:hover .card-action {
                opacity: 1; /* Aparece en hover */
                transform: translateX(0);
            }

        /* ESTILOS PARA SECCIÓN 3: NUESTRA PROMESA */
        .promise-card {
            background: #fff;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            border: 1px solid #e9ecef;
        }

            .promise-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.08);
            }

        .promise-icon {
            font-size: 3rem;
            color: var(--color-primario);
        }
        /*  NUEVOS ESTILOS PARA LAS TARJETAS DE MARCAS */
        /* Estilos para la rejilla de marcas con logos más grandes */

        .brand-logo-card {
            background-color: #1a1a1a;
            padding: 2rem 1rem;
            height: 120px; /* La altura de la tarjeta sigue igual */
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 0.5rem;
            border: 1px solid #333;
            transition: all 0.3s ease;
        }

            .brand-logo-card:hover {
                transform: translateY(-5px);
                border-color: #dc3545; /* Borde rojo al pasar el mouse */
                background-color: #222;
            }

            .brand-logo-card img {
                max-width: 90%;
                /* El ajuste clave para logos más grandes y visibles */
                max-height: 65px;
                object-fit: contain; /* Asegura que el logo no se deforme */
                filter: grayscale(1) brightness(1.5);
                transition: filter 0.3s ease;
            }

            .brand-logo-card:hover img {
                filter: grayscale(0) brightness(1);
            }


        /* --- Estilo para los Testimonios --- */
        .testimonial-card-v3 {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1.5rem;
            padding: 2rem;
            text-align: center;
            color: var(--color-texto-secundario);
        }

        /*
          Ya no es una <img>: son las iniciales del cliente sobre un círculo.
          Las fotos /images/client-N.jpg no existían (404) y el respaldo
          apuntaba a placehold.co, un servicio externo que en redes sin acceso
          a CDN tampoco carga. Así no hace falta ninguna petición.
        */
        .testimonial-img {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            margin: -50px auto 1rem;
            background: linear-gradient(135deg, #262626, #383838);
            color: var(--color-primario);
            font-size: 1.6rem;
            font-weight: 700;
            font-style: normal;
            letter-spacing: 0.03em;
            border: 4px solid var(--color-fondo-oscuro);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .testimonial-text {
            font-style: italic;
        }

        .testimonial-author {
            font-weight: 600;
            color: var(--color-texto-principal);
            margin-top: 1rem;
        }

        .testimonial-location {
            font-size: 0.9rem;
            color: var(--color-primario);
        }

        /*  NUEVOS ESTILOS PARA LA SECCIÓN DE SOPORTE */
        .support-section {
            background-color: var(--color-fondo-oscuro);
        }

        .support-container {
            background-color: #fff; /* Fondo blanco para el contenedor combinado */
            box-shadow: 0 20px 50px rgba(0,0,0,0.08);
            border-radius: 1rem;
            overflow: hidden;
        }

        .support-image {
            height: 100%;
            object-fit: cover;
            min-height: 450px;
        }

        .support-content h2 {
            line-height: 1.2;
            color: var(--color-texto-oscuro-fuerte);
        }

        .support-content .lead {
            color: var(--color-texto-oscuro-suave) !important;
        }

        .contact-details p {
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            color: var(--color-texto-oscuro-fuerte);
        }

        .contact-details .bi {
            color: var(--color-primario);
        }


        /* --- Eliminamos los estilos del newsletter anterior --- */
        .newsletter-section {
            display: none;
        }

                /* =======================================================
                     ESTILOS PARA SECCIÓN DE SOPORTE (DISEÑO LIMPIO)
                ======================================================= */

        /* --- Contenedor Principal y Layout --- */
        .support-container-pro {
            position: relative;
        }

        .support-image-wrapper {
            border-radius: 12px;
            overflow: hidden; /* Asegura que la imagen respete los bordes redondeados */
        }

        /* --- La Tarjeta de Contenido Superpuesta --- */
        .support-content-pro {
            background-color: #ffffff;
            padding: 40px;
            border-radius: 12px;
            /* La magia del layout: margen negativo para moverla sobre la imagen */
            margin-left: -80px;
            position: relative; /* Para asegurar que esté por encima */
            z-index: 2;
            border: 1px solid #dee2e6;
        }

        /* --- Tipografía y Acentos de Marca --- */
        .support-content-pro h3 {
            position: relative;
            padding-bottom: 10px;
            color: #212529;
        }

        /* Línea decorativa roja debajo del título */
        .support-content-pro h3::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 50px;
            height: 4px;
            background-color: #E53935; /* Color rojo de la marca */
            border-radius: 2px;
        }

        .support-content-pro p {
            color: #495057;
            line-height: 1.7;
        }

        /* --- Detalles de Contacto Mejorados --- */
        .contact-details-pro p {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            font-size: 1.05rem;
            font-weight: 500;
        }

        .contact-details-pro i {
            color: #E53935; /* Íconos en el color de la marca */
            font-size: 1.5rem;
            margin-right: 15px;
            width: 25px; /* Ancho fijo para alineación perfecta */
        }


        /*
