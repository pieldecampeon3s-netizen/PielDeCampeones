<%#
  Tarjeta de producto. Sus estilos viven en /css/catalogo.css, no aquí: este
  parcial se repite una vez por producto y además se reinyecta al filtrar sin
  recargar, así que un <style> propio se duplicaría en cada tarjeta.

  Espera: producto, formatCOP, favoritos
%>
<% const esFavorito = (typeof favoritos !== 'undefined' ? favoritos : []).includes(producto.id); %>

<div class="product-card <%= producto.stock > 0 ? '' : 'agotado' %>">

    <div class="product-card-image-container">
        <a href="/producto/<%= producto.id %>">
            <img src="<%= producto.imagenUrl %>"
                 alt="<%= producto.nombre %>"
                 loading="lazy"
                 decoding="async">
        </a>

        <%# Favorito. Va fuera del enlace para que tocarlo no abra el producto. %>
        <button type="button"
                class="btn-favorito <%= esFavorito ? 'activo' : '' %>"
                data-favorito="<%= producto.id %>"
                aria-pressed="<%= esFavorito %>"
                aria-label="<%= esFavorito ? 'Quitar de favoritos' : 'Guardar en favoritos' %>">
            <i class="bi bi-heart<%= esFavorito ? '-fill' : '' %>"></i>
        </button>

        <% if (producto.stock === 0) { %>
            <span class="etiqueta-stock etiqueta-agotado">Agotado</span>
        <% } else if (producto.stock <= 10) { %>
            <span class="etiqueta-stock etiqueta-ultimas">Últimas <%= producto.stock %></span>
        <% } %>
    </div>

    <div class="product-card-body">
        <h5 class="product-name">
            <a href="/producto/<%= producto.id %>"><%= producto.nombre %></a>
        </h5>

        <p class="product-price"><%= formatCOP(producto.precio) %></p>

        <% if (producto.stock <= 0) { %>
            <span class="chip-talla chip-agotado">Sin stock</span>
        <% } else if ((producto.tallasStock || []).length) { %>
            <%# Abre la hoja de tallas: desde ahí se añade al carrito. %>
            <button type="button"
                    class="chip-talla elegir-talla-btn"
                    data-producto-id="<%= producto.id %>"
                    data-nombre="<%= producto.nombre %>"
                    data-precio="<%= formatCOP(producto.precio) %>"
                    data-imagen="<%= producto.imagenUrl %>"
                    data-tallas-stock='<%- JSON.stringify(producto.tallasStock) %>'>
                Talla: <strong>elegir</strong>
            </button>
        <% } else { %>
            <button type="button"
                    class="chip-talla add-to-cart-btn"
                    data-producto-id="<%= producto.id %>"
                    data-cantidad="1">
                <i class="bi bi-cart-plus"></i> Añadir
            </button>
        <% } %>
    </div>
</div>
