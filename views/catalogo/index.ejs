<section class="store-hero">
    <div class="store-overlay"></div>

    <div class="container text-center position-relative">
        <span class="badge bg-danger px-3 py-2 mb-3">
            ⚽ NUEVA COLECCIÓN
        </span>

        <h1 class="display-3 fw-bold">
            Tienda Oficial
        </h1>

        <p class="lead">
            Descubre camisetas oficiales, retro y de edición especial de los mejores clubes y selecciones del mundo.
        </p>
    </div>
</section>

<div class="container py-5">

    <div class="row">

        <div class="col-lg-3">

            <%#
              En móvil los filtros van plegados. Desplegados ocupan toda la
              primera pantalla y el usuario no ve ni una camiseta sin hacer
              scroll. En escritorio (d-lg-block) siguen siempre visibles.
            %>
            <button class="btn btn-outline-light w-100 mb-3 d-lg-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#filtrosCatalogo"
                    aria-expanded="false"
                    aria-controls="filtrosCatalogo">
                <i class="bi bi-sliders me-2"></i>Filtrar y ordenar
            </button>

            <aside class="filter-sidebar collapse d-lg-block" id="filtrosCatalogo">

                <form action="/catalogo" method="get">

                    <div class="filter-widget">

                        <h5 class="widget-title">
                            Ordenar
                        </h5>

                        <select name="orden" class="form-select" onchange="this.form.submit()">

                            <option value="relevancia" <% if (ordenActual==='relevancia') { %>selected<% } %>>
                                Más relevantes
                            </option>

                            <option value="precio-asc" <% if (ordenActual==='precio-asc') { %>selected<% } %>>
                                Precio menor
                            </option>

                            <option value="precio-desc" <% if (ordenActual==='precio-desc') { %>selected<% } %>>
                                Precio mayor
                            </option>

                            <option value="nombre-asc" <% if (ordenActual==='nombre-asc') { %>selected<% } %>>
                                Nombre A-Z
                            </option>

                        </select>

                    </div>

                    <div class="filter-widget">

                        <h5 class="widget-title">
                            Equipos
                        </h5>

                        <div class="filter-list">

                            <a href="/catalogo" class="filter-item <%= !categoriaActual?'active':'' %>">

                                Todas

                            </a>

                            <% (todasLasCategorias || []).forEach(function (categoria) { %>
                                <a href="/catalogo?categoria=<%= encodeURIComponent(categoria) %>" class="filter-item <%= categoria==categoriaActual?'active':'' %>">

                                    <%= categoria %>

                                </a>
                            <% }); %>

                        </div>

                    </div>

                </form>

            </aside>

        </div>

        <div class="col-lg-9">

            <% if (productos.length > 0) { %>
                <%# 2 columnas en móvil: es el estándar en catálogos de ropa %>
                <div class="row row-cols-2 row-cols-md-2 row-cols-xl-3 g-3 g-md-4">

                    <% (productos || []).forEach(function (producto) { %>
                        <div class="col">

                            <%- include('../partials/product-card', { producto: producto }) %>

                        </div>
                    <% }); %>

                </div>
            <% } else { %>
                <div class="empty-products">

                    <i class="bi bi-search display-1"></i>

                    <h3>
                        No encontramos camisetas
                    </h3>

                    <p>
                        Prueba otra categoría o elimina los filtros.
                    </p>

                    <a href="/catalogo" class="btn btn-danger">

                        Ver toda la tienda

                    </a>

                </div>
            <% } %>

        </div>

    </div>

</div>
<style>
    .store-hero {
        position: relative;
        height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #121212;
        /* Reutiliza la foto de la portada. Antes apuntaba a store-banner.jpg,
           que no existe: la cabecera se veía como un rectángulo negro. */
        background: url('/images/futbol-1280.webp') center center/cover no-repeat;
        background-image: image-set(url('/images/futbol-1280.webp') type('image/webp'),
                                    url('/images/futbol.jpg') type('image/jpeg'));
    }

    .store-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,.65);
    }

    .store-hero .container {
        z-index: 2;
    }

    .store-hero h1 {
        color: white;
        font-weight: 800;
    }

    .store-hero p {
        color: #d8d8d8;
        max-width: 700px;
        margin: auto;
    }

    .filter-sidebar {
        background: #181818;
        border-radius: 18px;
        padding: 25px;
        position: sticky;
        top: 100px;
    }

    .widget-title {
        color: white;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .filter-item {
        display: block;
        color: #cfcfcf;
        padding: 12px 15px;
        text-decoration: none;
        border-radius: 10px;
        transition: .3s;
    }

        .filter-item:hover {
            background: #2a2a2a;
            color: white;
        }

        .filter-item.active {
            background: #d90429;
            color: white;
        }

    .empty-products {
        text-align: center;
        padding: 100px 20px;
    }

        .empty-products i {
            color: #d90429;
        }

        .empty-products h3 {
            color: white;
            margin-top: 20px;
        }

        .empty-products p {
            color: #bdbdbd;
        }</style>
