<h1 class="h2"><%= title %></h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post" action="/admin/categorias/editar">
            <input type="hidden" />
            <div class="text-danger"></div>
            <div class="mb-3">
                <label for="nombre" class="form-label"></label>
                <input name="nombre" id="nombre" class="form-control" />
                <span class="text-danger"><%= (errores && errores.nombre) || '' %></span>
            </div>
            <div class="mb-3">
                <label for="descripcion" class="form-label"></label>
                <textarea name="descripcion" id="descripcion" class="form-control" rows="3"></textarea>
                <span class="text-danger"><%= (errores && errores.descripcion) || '' %></span>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <a href="/admin/categorias" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

