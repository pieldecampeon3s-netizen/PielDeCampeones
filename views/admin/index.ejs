<div class="container mt-4">
    <%- include('../partials/admin/aviso-swal') %>

    <h1 class="h2 mb-4">Dashboard</h1>

    <div class="row g-4 mb-5 justify-content-center">
        <div class="col-lg-3 col-md-6">
            <div class="kpi-card productos">
                <div class="kpi-icon"><i class="bi bi-box-seam"></i></div> <div> <div class="kpi-value"><%= dashboard.totalProductos %></div> <div class="kpi-label">Total de Productos</div> </div> </div> </div>
        <div class="col-lg-3 col-md-6">
            <a href="/admin/categorias" class="text-decoration-none">
                <div class="kpi-card categorias">
                    <div class="kpi-icon"><i class="bi bi-tags"></i></div>
                    <div>
                        <div class="kpi-value"><%= dashboard.totalCategorias %></div>
                        <div class="kpi-label">Total de Categorías</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="kpi-card stock">
                <div class="kpi-icon"><i class="bi bi-exclamation-triangle"></i></div> <div> <div class="kpi-value"><%= dashboard.productosBajoStock %></div> <div class="kpi-label">Productos con Bajo Stock</div> </div> </div> </div>
    </div>

    <div class="row g-4 mb-5 justify-content-center">
        <div class="col-md-6 col-lg-3 d-flex">
            <a href="/admin/productos" class="quick-action-card">
                <i class="bi bi-boxes"></i>
                <h4>Gestionar Productos</h4>
                <i class="bi bi-chevron-right quick-action-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-lg-3 d-flex">
            <a href="/admin/categorias" class="quick-action-card">
                <i class="bi bi-tags"></i>
                <h4>Administrar Categorías</h4>
                <i class="bi bi-chevron-right quick-action-flecha"></i>
            </a>
        </div>
        <div class="col-md-6 col-lg-3 d-flex">
            <a href="/admin/usuarios" class="quick-action-card">
                <i class="bi bi-people"></i>
                <h4>Gestionar Usuarios</h4>
                <i class="bi bi-chevron-right quick-action-flecha"></i>
            </a>
        </div>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <div class="tarjeta-config-admin">
                <h5 class="mb-3"><i class="bi bi-eye-slash me-2"></i>Catálogo</h5>
                <form action="/admin/configuracion" method="post" class="fila-interruptor-admin">
                    <label for="ocultarAgotados">Ocultar productos agotados de la tienda</label>
                    <input type="checkbox"
                           id="ocultarAgotados"
                           name="ocultarAgotados"
                           <%= ocultarAgotados ? 'checked' : '' %>
                           onchange="this.form.requestSubmit()">
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* VARIABLES GLOBALES */
    :root {
        --color-fondo: #121212;
        --color-superficie-oscura: #1E1E1E;
        --color-borde-oscuro: #2F2F2F;
        --color-primario: #E53559;
        --color-texto-principal: #EAEAEA;
        --color-texto-secundario: #A0A0A0;
        --color-verde: #30d158;
        --color-azul: #3d9eff;
        --color-amarillo: #ffc400;
        --color-naranja: #ff9500;
        --color-morado: #af52de;
    }

    /* ESTILOS TARJETAS KPI (Sin cambios) */
    .kpi-card {
        background: radial-gradient(circle, rgba(40,40,42,1) 0%, var(--color-superficie-oscura) 100%);
        border: 1px solid var(--color-borde-oscuro);
        border-radius: 1rem;
        color: var(--color-texto-principal);
        padding: 1.5rem;
        display: flex;
        align-items: center;
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out, border-color 0.3s ease-in-out;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

        .kpi-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.3);
            border-color: rgba(255, 255, 255, 0.2);
        }

    .kpi-icon {
        font-size: 2rem;
        margin-right: 1.5rem;
        width: 60px;
        height: 60px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.03);
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    .kpi-card.productos .kpi-icon {
        color: var(--color-azul);
    }

    .kpi-card.ventas .kpi-icon {
        color: var(--color-verde);
    }

    .kpi-card.stock .kpi-icon {
        color: var(--color-primario);
    }

    .kpi-card:hover .kpi-icon {
        background-color: rgba(255, 255, 255, 0.08);
    }

    .kpi-value {
        font-size: 2.2rem;
        font-weight: 600;
        line-height: 1;
        color: var(--color-texto-principal);
    }

    .kpi-label {
        font-size: 0.9rem;
        color: var(--color-texto-secundario);
        font-weight: 400;
    }

    /* ESTILOS TARJETAS DE ACCIÓN (Sin cambios) */
    .quick-action-card {
        background: var(--color-superficie-oscura);
        border-radius: 1rem;
        padding: 2rem;
        text-align: center;
        color: var(--color-texto-principal);
        text-decoration: none;
        display: block;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease-in-out;
        border: 1px solid var(--color-borde-oscuro);
        height: 100%;
    }

        .quick-action-card:hover {
            transform: translateY(-8px);
            color: #fff;
        }

        .quick-action-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            border-radius: 1rem;
            border: 2px solid transparent;
            background: conic-gradient(from var(--angle), var(--color-primario), var(--color-azul), var(--color-verde), var(--color-primario)) border-box;
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask-composite: exclude;
            -webkit-mask-composite: destination-out;
            animation: rotate 4s linear infinite;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .quick-action-card:hover::before {
            opacity: 1;
        }

        .quick-action-card i {
            font-size: 3rem;
            margin-bottom: 1rem;
            display: block;
            color: var(--color-texto-secundario);
            transition: all 0.3s ease;
            position: relative;
            z-index: 2;
        }

        .quick-action-card h4 {
            position: relative;
            z-index: 2;
        }

        .quick-action-card:hover i {
            transform: scale(1.1);
        }

        .quick-action-card:hover [class*="bi-boxes"] {
            color: var(--color-azul);
        }

        .quick-action-card:hover [class*="bi-tags"] {
            color: var(--color-verde);
        }

        .quick-action-card:hover [class*="bi-people"] {
            color: var(--color-primario);
        }

        /* La flechita solo pinta algo en la fila compacta de móvil (ver
           media query abajo); en escritorio, con la tarjeta grande y
           centrada, no aporta nada y queda oculta. */
        .quick-action-flecha {
            display: none;
        }

    /*
      Móvil: la tarjeta alta y centrada (icono grande arriba, texto abajo,
      mucho aire) se ve vacía y ocupa media pantalla por 3 accesos que en el
      fondo son solo enlaces a una lista. Se compactan en filas horizontales,
      como el resto de accesos rápidos del panel (mismo espíritu que
      cuenta-accesos en la página "Mi cuenta"): icono a color en un círculo,
      el texto al lado y una flecha al final para que se note que son
      tocables. El color de cada icono deja de depender del :hover (que en
      un teléfono casi nunca se dispara) y queda fijo siempre.
    */
    @media (max-width: 767.98px) {
        .quick-action-card {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.1rem;
            text-align: left;
            min-height: 48px;
        }

        .quick-action-card i:not(.quick-action-flecha) {
            flex: none;
            width: 46px;
            height: 46px;
            margin-bottom: 0;
            font-size: 1.4rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255, 255, 255, .05);
        }

        .quick-action-card [class*="bi-boxes"] { color: var(--color-azul); }
        .quick-action-card [class*="bi-tags"] { color: var(--color-verde); }
        .quick-action-card [class*="bi-people"] { color: var(--color-primario); }

        .quick-action-card h4 {
            flex: 1;
            margin: 0;
            font-size: 1rem;
        }

        .quick-action-flecha {
            display: block;
            flex: none;
            font-size: 1rem;
            color: var(--color-texto-secundario);
        }

        /* El brillo giratorio del borde no tiene sentido sin :hover real. */
        .quick-action-card::before {
            display: none;
        }

        .quick-action-card:hover {
            transform: none;
        }
    }

    /* ESTILO PARA EL CONTENEDOR DEL GRÁFICO */
    .chart-container {
        background-color: var(--color-superficie-oscura);
        padding: 2rem;
        border-radius: 1rem;
        border: 1px solid var(--color-borde-oscuro);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
</style>
