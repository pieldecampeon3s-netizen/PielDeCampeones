<%#
  Checkout. Pensado para móvil primero: una sola columna de tarjetas, con el
  botón de enviar el pedido al alcance del pulgar. En escritorio el resumen se
  coloca al lado en vez de debajo.

  Estilos en /css/checkout.css, comportamiento en /js/checkout.js.

  Espera: carrito, formatCOP
%>

<%# --- Barra superior propia (esta página no lleva la navbar del sitio) --- %>
<header class="checkout-topbar">
    <a href="/carrito" class="topbar-volver" aria-label="Volver al carrito">
        <i class="bi bi-chevron-left"></i>
    </a>

    <span class="topbar-marca">
        <i class="bi bi-award-fill"></i>
        Piel de Campeón
    </span>

    <a href="/carrito" class="topbar-bolsa" aria-label="Ver el carrito">
        <i class="bi bi-bag"></i>
        <span class="topbar-cuenta"><%= carrito.items.reduce(function (a, i) { return a + i.cantidad; }, 0) %></span>
    </a>
</header>

<div class="checkout-envoltorio">

    <%# --- Pasos --- %>
    <ol class="pasos-compra">
        <li class="paso completado">
            <span class="paso-icono"><i class="bi bi-cart-fill"></i></span>
            <span class="paso-texto">1. Carrito</span>
        </li>
        <li class="paso activo">
            <span class="paso-icono"><i class="bi bi-person-fill"></i></span>
            <span class="paso-texto">2. Información</span>
        </li>
        <li class="paso">
            <span class="paso-icono"><i class="bi bi-check-lg"></i></span>
            <span class="paso-texto">3. Confirmación</span>
        </li>
    </ol>

    <div class="checkout-columnas">

        <div class="checkout-principal">

            <form id="formPedido" novalidate>

                <%# --- Contacto --- %>
                <section class="tarjeta-checkout">
                    <h2 class="tarjeta-titulo">
                        <span class="tarjeta-icono"><i class="bi bi-person-fill"></i></span>
                        Información de contacto
                    </h2>

                    <div class="campo">
                        <label for="nombre">Nombre completo</label>
                        <div class="campo-caja">
                            <i class="bi bi-person"></i>
                            <input type="text"
                                   id="nombre"
                                   name="nombre"
                                   placeholder="Ej: Andrés Ramírez"
                                   autocomplete="name"
                                   required>
                        </div>
                        <p class="campo-error" data-error-de="nombre"></p>
                    </div>

                    <div class="campo">
                        <label for="telefono">Teléfono</label>
                        <div class="campo-caja">
                            <i class="bi bi-telephone"></i>
                            <input type="tel"
                                   id="telefono"
                                   name="telefono"
                                   placeholder="Ej: 300 123 4567"
                                   inputmode="tel"
                                   autocomplete="tel"
                                   required>
                        </div>
                        <p class="campo-error" data-error-de="telefono"></p>
                        <p class="campo-ayuda">
                            <i class="bi bi-check-circle-fill"></i>
                            Usaremos tu número para mantenerte informado
                        </p>
                    </div>
                </section>

                <%# --- Envío --- %>
                <section class="tarjeta-checkout">
                    <h2 class="tarjeta-titulo">
                        <span class="tarjeta-icono"><i class="bi bi-geo-alt-fill"></i></span>
                        Dirección de envío
                    </h2>

                    <div class="campo">
                        <label for="ciudad">Ciudad</label>
                        <div class="campo-caja">
                            <i class="bi bi-buildings"></i>
                            <input type="text"
                                   id="ciudad"
                                   name="ciudad"
                                   placeholder="Ej: Bogotá D.C."
                                   autocomplete="address-level2"
                                   required>
                        </div>
                        <p class="campo-error" data-error-de="ciudad"></p>
                    </div>

                    <div class="campo">
                        <label for="direccion">Dirección</label>
                        <div class="campo-caja">
                            <i class="bi bi-house"></i>
                            <input type="text"
                                   id="direccion"
                                   name="direccion"
                                   placeholder="Calle, número, barrio..."
                                   autocomplete="street-address"
                                   required>
                        </div>
                        <p class="campo-error" data-error-de="direccion"></p>
                    </div>

                    <div class="campo">
                        <label for="referencia">
                            Apartamento o referencia <span class="opcional">(opcional)</span>
                        </label>
                        <div class="campo-caja">
                            <i class="bi bi-signpost"></i>
                            <input type="text"
                                   id="referencia"
                                   name="referencia"
                                   placeholder="Apartamento, interior, referencia">
                        </div>
                    </div>

                    <button type="submit" class="btn-whatsapp">
                        <i class="bi bi-whatsapp"></i>
                        Enviar pedido por WhatsApp
                    </button>

                    <p class="nota-whatsapp">
                        Se abrirá WhatsApp con tu pedido ya escrito.
                        Allí coordinamos el pago y el envío.
                    </p>
                </section>
            </form>
        </div>

        <div class="checkout-resumen">

            <div class="resumen-cabecera">
                <h2>Resumen de tu pedido (<%= carrito.items.length %>)</h2>
                <a href="/carrito" class="editar-carrito">
                    Editar carrito <i class="bi bi-pencil"></i>
                </a>
            </div>

            <ul class="lista-pedido">
                <% carrito.items.forEach(function (item) { %>
                    <li class="linea-pedido">
                        <div class="linea-imagen">
                            <img src="<%= item.imagenUrl %>" alt="<%= item.nombreProducto %>" loading="lazy" onerror="this.onerror=null;this.src='/images/placeholder.png';">
                            <span class="linea-cantidad"><%= item.cantidad %></span>
                        </div>

                        <div class="linea-datos">
                            <p class="linea-nombre"><%= item.nombreProducto %></p>
                            <% if (item.talla) { %>
                                <p class="linea-talla">Talla: <strong><%= item.talla %></strong></p>
                            <% } %>
                        </div>

                        <p class="linea-precio"><%= formatCOP(item.subtotal) %></p>
                    </li>
                <% }); %>
            </ul>

            <div class="tarjeta-totales">
                <div class="fila-total">
                    <span>Subtotal</span>
                    <span><%= formatCOP(carrito.total) %></span>
                </div>

                <div class="fila-total">
                    <span>Envío</span>
                    <span class="envio-coordinar">A coordinar</span>
                </div>

                <div class="fila-total gran-total">
                    <span>Total</span>
                    <span><%= formatCOP(carrito.total) %></span>
                </div>
            </div>

            <div class="aviso-seguro">
                <span class="aviso-icono"><i class="bi bi-shield-check"></i></span>
                <div>
                    <strong>Compra segura</strong>
                    <small>Coordinamos pago y envío contigo por WhatsApp</small>
                </div>
            </div>
        </div>
    </div>
</div>

<%#
  El pedido para el mensaje de WhatsApp, servido como datos y no leído del
  HTML: así el mensaje no se rompe si algún día cambia la maquetación.
%>
<script type="application/json" id="datosPedido">
    <%- JSON.stringify({
        whatsapp: whatsapp,
        total: formatCOP(carrito.total),
        items: carrito.items.map(function (i) {
            return {
                nombre: i.nombreProducto,
                talla: i.talla || '',
                cantidad: i.cantidad,
                subtotal: formatCOP(i.subtotal),
            };
        }),
    }) %>
</script>
