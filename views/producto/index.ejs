<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2"><%= title %></h1>
        <a href="/admin/productos/crear" class="btn btn-primary" style="background-color: var(--color-primario); border-color: var(--color-primario);">
            <i class="bi bi-plus-circle-fill me-2"></i>Añadir Nuevo Producto
        </a>
    </div>

    <div class="card order-details-card p-4">
        <div class="table-responsive">
            <table class="table table-dark-custom table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width: 5%;"></th>
                        <th>Nombre del Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% (productos || []).forEach(function (item) { %>
                        <tr>
                            <td>
                                <img src="<%= item.imagenUrl %>" style="width: 40px; height: 40px; object-fit: cover; border-radius: 5px;" onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                            </td>
                            <td>
                                <strong><%= item.nombre %></strong><br>
                                <small class="text-muted">OEM: <%= item.oem %></small>
                            </td>
                            <td><%= item.nombreCategoria %></td>
                            <td class="text-end"><%= formatCOP(item.precio) %></td>
                            <td class="text-center">
                                <% const stockClass = item.stock > 20 ? "bg-success" : (item.stock > 0 ? "bg-warning" : "bg-danger"); %>
                                <span class="badge <%= stockClass %>"><%= item.stock %></span>
                            </td>
                            <td class="text-end">
                                <a href="/admin/productos/editar/<%= item.id %>" class="btn btn-sm btn-outline-warning">Editar</a>
                                <a href="/admin/productos/eliminar/<%= item.id %>" class="btn btn-sm btn-outline-danger ms-2">Eliminar</a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>
