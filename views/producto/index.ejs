<div class="container-fluid mt-4">
    <%- include('../partials/admin/aviso-swal') %>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="h2"><%= title %></h1>
        <div class="d-flex flex-wrap gap-2">
            <a href="/admin/categorias/crear" class="btn btn-outline-light">
                <i class="bi bi-tags-fill me-2"></i>Añadir Nueva Categoría
            </a>
            <a href="/admin/productos/crear" class="btn btn-primary" style="background-color: var(--color-primario); border-color: var(--color-primario);">
                <i class="bi bi-plus-circle-fill me-2"></i>Añadir Nuevo Producto
            </a>
        </div>
    </div>

    <div class="card order-details-card p-4">
        <div class="table-responsive">
            <table class="table table-dark-custom table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nombre del Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% (productos || []).forEach(function (item) { %>
                        <tr class="<%= item.estado ? '' : 'fila-oculta' %>">
                            <td class="celda-cabecera-tarjeta">
                                <img src="<%= item.imagenUrl %>" style="width: 40px; height: 40px; object-fit: cover; border-radius: 5px; flex: none;" onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                                <span>
                                    <strong><%= item.nombre %></strong>
                                    <% if (!item.estado) { %>
                                        <span class="badge badge-oculto">Oculto</span>
                                    <% } %>
                                    <br>
                                    <small class="text-muted">OEM: <%= item.oem %></small>
                                </span>
                            </td>
                            <td data-label="Categoría"><%= item.nombreCategoria %></td>
                            <td data-label="Precio" class="text-end"><%= formatCOP(item.precio) %></td>
                            <td data-label="Stock" class="text-center">
                                <% const stockClass = item.stock > 20 ? "bg-success" : (item.stock > 0 ? "bg-warning" : "bg-danger"); %>
                                <span class="badge <%= stockClass %>"><%= item.stock %></span>
                            </td>
                            <td class="text-end celda-acciones-tarjeta">
                                <a href="/admin/productos/editar/<%= item.id %>" class="btn btn-sm btn-outline-warning">Editar</a>
                                <% if (item.estado) { %>
                                    <form action="/admin/productos/eliminar/<%= item.id %>" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger ms-2">Ocultar</button>
                                    </form>
                                <% } else { %>
                                    <form action="/admin/productos/activar/<%= item.id %>" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success ms-2">Activar</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>
