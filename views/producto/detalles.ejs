<div class="container my-5 pt-5">
    <div class="row">
        <div class="col-lg-6" data-aos="fade-right">
            <div class="product-image-gallery">
                <img src="<%= producto.imagenUrl %>" alt="<%= producto.nombre %>" class="main-image shadow-lg" onerror="this.onerror=null;this.src='/images/placeholder.png';">
            </div>
        </div>

        <div class="col-lg-6" data-aos="fade-left" data-aos-delay="100">
            <div class="product-details-panel">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <%# Inicio y la tienda son la misma página: una sola miga. %>
                        <li class="breadcrumb-item"><a href="/">Tienda</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><%= producto.nombre %></li>
                    </ol>
                </nav>

                <h1 class="product-title-detail display-5"><%= producto.nombre %></h1>
                <p class="product-oem-detail">OEM: <%= producto.oem %></p>

                <p class="product-price-detail"><%= formatCOP(producto.precio) %></p>

                <% if (producto.stock > 0) { %>
                    <p class="stock-status-detail available"><i class="bi bi-check-circle-fill"></i> En Stock</p>
                <% } else { %>
                    <p class="stock-status-detail unavailable"><i class="bi bi-x-circle-fill"></i> Agotado</p>
                <% } %>

                <p class="product-description-detail"><%= producto.descripcion %></p>

                <form id="form-add-to-cart" data-product-id="<%= producto.id %>" class="purchase-form mt-4">

                    <% if ((producto.tallasStock || []).length) { %>
                        <div class="selector-tallas mb-4">
                            <div class="tallas-cabecera">
                                <span class="form-label mb-0">Talla:</span>
                                <a href="/images/tabla-tallas.png" target="_blank" class="enlace-guia-tallas">
                                    <i class="bi bi-rulers"></i> Guía de tallas
                                </a>
                            </div>

                            <div class="tallas-opciones" role="radiogroup" aria-label="Elige tu talla">
                                <% producto.tallasStock.forEach(function (t) { %>
                                    <input type="radio"
                                           class="talla-radio"
                                           name="talla"
                                           id="talla-<%= t.talla %>"
                                           value="<%= t.talla %>"
                                           data-stock="<%= t.stock %>"
                                           <%= t.stock <= 0 ? 'disabled' : '' %>>
                                    <label class="talla-opcion <%= t.stock <= 0 ? 'talla-agotada' : '' %>" for="talla-<%= t.talla %>"><%= t.talla %></label>
                                <% }); %>
                            </div>

                            <p class="talla-aviso" id="avisoTalla" hidden>
                                <i class="bi bi-exclamation-circle"></i> Elige una talla para continuar.
                            </p>
                        </div>
                    <% } %>

                    <%#
                      Cantidad y botón en la misma fila, centrados. Los botones
                      de − y + evitan tener que escribir el número, que en un
                      teclado de móvil es incómodo.

                      `data-stock` lo lee producto.js para no dejar pasar del
                      stock. El servidor lo comprueba igualmente: el navegador
                      es una comodidad, no una barrera.
                    %>
                    <div class="compra-fila">
                        <div class="selector-cantidad" data-stock="<%= producto.stock %>">
                            <label for="quantity">Cantidad</label>

                            <div class="cantidad-control">
                                <button type="button"
                                        class="cantidad-btn"
                                        data-paso="-1"
                                        aria-label="Quitar una unidad"
                                        <%= producto.stock > 0 ? 'disabled' : 'disabled' %>>
                                    <i class="bi bi-dash-lg"></i>
                                </button>

                                <input type="number"
                                       id="quantity"
                                       class="cantidad-valor"
                                       value="1"
                                       min="1"
                                       max="<%= producto.stock %>"
                                       inputmode="numeric"
                                       aria-describedby="avisoStock"
                                       <%= producto.stock > 0 ? '' : 'disabled' %>>

                                <button type="button"
                                        class="cantidad-btn"
                                        data-paso="1"
                                        aria-label="Añadir una unidad"
                                        <%= producto.stock > 1 ? '' : 'disabled' %>>
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>

                            <p class="aviso-stock" id="avisoStock" aria-live="polite">
                                <% if (producto.stock > 0 && producto.stock <= 10) { %>
                                    Quedan <%= producto.stock %> unidades
                                <% } %>
                            </p>
                        </div>

                        <button type="submit"
                                class="btn btn-brand-accent btn-lg btn-agregar"
                                <%= producto.stock > 0 ? '' : 'disabled' %>>
                            <i class="bi bi-cart-plus-fill me-2"></i>
                            <%= producto.stock > 0 ? 'Agregar al Carrito' : 'Agotado' %>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 🔔 Notificación emergente personalizada -->
<div id="notificacion" class="notificacion-oculta"></div>



<style>
    /* =======================================================
   ESTILOS PARA PÁGINA DE DETALLES DE PRODUCTO
   ======================================================= */
.product-image-gallery .main-image {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--color-borde-claro);
}

/* El hueco a la izquierda separa la columna de texto de la foto en el diseño
   de escritorio a dos columnas. Sin el @media también se aplicaba en móvil,
   donde solo hay una columna: desplazaba el recuadro de compra 32px hacia
   la derecha, descentrándolo del contenedor. */
@media (min-width: 992px) {
    .product-details-panel {
        padding-left: 2rem;
    }
}

.breadcrumb {
    font-size: 0.9rem;
}

.breadcrumb-item a {
    color: var(--color-acento-principal);
    text-decoration: none;
}

.product-title-detail {
    font-weight: 700;
    color: var(--color-texto-sobre-claro);
}

.product-oem-detail {
    font-size: 0.9rem;
    color: var(--color-texto-suave);
    text-transform: uppercase;
    margin-top: -0.5rem;
}

.product-price-detail {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-acento-principal);
    margin: 1.5rem 0;
}

.stock-status-detail {
    font-weight: 600;
    display: flex;
    align-items: center;
}
.stock-status-detail.available { color: #1a9e3a; }
.stock-status-detail.unavailable { color: var(--color-enfasis-alerta); }
.stock-status-detail i { margin-right: 0.5rem; }

.product-description-detail {
    color: var(--color-texto-suave);
    line-height: 1.7;
    margin-top: 1.5rem;
}

.purchase-form {
    background-color: #f8f9fa;
    padding: 1.5rem;
    border-radius: 8px;
    margin-top: 2rem !important;
}

.quantity-input {
    text-align: center;
    font-weight: 600;
}

    #notificacion {
        position: fixed;
        top: 20px;
        right: 20px;
        background-color: #1f2937;
        color: white;
        padding: 15px 25px;
        border-radius: 8px;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.3);
        font-weight: 500;
        z-index: 9999;
        opacity: 0;
        transform: translateY(-20px);
        transition: all 0.3s ease-in-out;
        pointer-events: none; /* ✅ permite hacer clic a través del div */
    }


        #notificacion.mostrar {
            opacity: 1;
            transform: translateY(0);
        }


</style>
<script>
        function mostrarNotificacion(mensaje, esError = false) {
            const noti = document.getElementById("notificacion");
            noti.innerText = mensaje;
            noti.classList.add("mostrar");
            if (esError) {
                noti.style.backgroundColor = "#c0392b"; // rojo para error
            } else {
                noti.style.backgroundColor = "#1f2937"; // gris oscuro para éxito
            }

            setTimeout(() => {
                noti.classList.remove("mostrar");
            }, 3000);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('form-add-to-cart');

            if (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();

                    const productoId = form.dataset.productId;
                    const cantidad = document.getElementById('quantity').value;

                    // Si el producto maneja tallas, hay que elegir una.
                    const grupoTallas = form.querySelector('.selector-tallas');
                    const tallaMarcada = form.querySelector('input[name="talla"]:checked');
                    const aviso = document.getElementById('avisoTalla');

                    if (grupoTallas && !tallaMarcada) {
                        if (aviso) aviso.hidden = false;
                        grupoTallas.scrollIntoView({ block: 'center', behavior: 'smooth' });
                        return;
                    }
                    if (aviso) aviso.hidden = true;

                    fetch('/carrito/agregar', {
                        method: 'POST',
                        // JSON, que es lo que el servidor sabe leer. Antes se
                        // enviaba FormData (multipart) y no llegaba nada.
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            productoId: productoId,
                            cantidad: Number(cantidad),
                            talla: tallaMarcada ? tallaMarcada.value : ''
                        })
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Respuesta del servidor no fue OK: ' + response.status);
                            }
                            return response.json();
                        })
                        .then(result => {
                            if (result.success) {
                                mostrarNotificacion(result.message);
                                // La burbuja de la navbar es #cart-badge (ver navbar.ejs).
                                if (typeof window.updateCartCount === 'function') {
                                    window.updateCartCount();
                                }
                            } else {
                                mostrarNotificacion('Error: ' + result.message, true);
                            }
                        })
                        .catch(error => {
                            console.error('Error al añadir al carrito:', error);
                            mostrarNotificacion('Hubo un problema de comunicación con el servidor.', true);
                        });
                });
            }
        });
    </script>
