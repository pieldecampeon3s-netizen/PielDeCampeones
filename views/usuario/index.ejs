<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2"><%= title %></h1>
        <a href="/admin" class="btn btn-outline-secondary">Volver al Dashboard</a>
    </div>

    <div class="card order-details-card p-4">
        <div class="table-responsive">
            <table class="table table-dark-custom table-hover mb-0">
                <thead>
                    <tr>
                        <th>ID de Usuario</th>
                        <th>Usuario</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% (usuarios || []).forEach(function (user) { %>
                        <tr>
                            <td><small><%= user.id %></small></td>
                            <td><strong><%= user.userName %></strong></td>
                            <td><%= user.email %></td>
                            <td>
                                <% if (user.roles.length > 0) { %>
                                    <% (user.roles || []).forEach(function (role) { %>
                                        <span class="badge me-1 <%= role == 'Administrador' ? 'bg-danger' : 'bg-primary' %>"><%= role %></span>
                                    <% }); %>
                                <% } else { %>
                                    <span class="badge bg-secondary">Sin rol</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <a href="#" class="btn btn-sm btn-outline-warning disabled">Editar Roles</a>
                                <a href="#" class="btn btn-sm btn-outline-danger ms-2 disabled">Eliminar</a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>
