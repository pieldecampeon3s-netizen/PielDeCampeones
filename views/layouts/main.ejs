<%#
  Layout principal — equivalente a Views/Shared/_Layout.cshtml del proyecto .NET.
  Locals que espera:
    title    (string)        título de la pestaña
    usuario  (objeto|null)   { nombre, email, esAdmin } — null si no hay sesión
  El contenido de cada página se inyecta en la variable "body".
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' && title ? title : 'Piel de Campeón' %></title>

    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />

    <style>
        .animate-on-scroll {
            opacity: 0;
            transition: opacity 1s cubic-bezier(0.23, 1, 0.32, 1), transform 1s cubic-bezier(0.23, 1, 0.32, 1);
        }

            .animate-on-scroll[data-animation="fade-up"] {
                transform: translateY(50px);
            }

            .animate-on-scroll[data-animation="zoom-in"] {
                transform: scale(0.95);
            }

            .animate-on-scroll.is-visible {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

        #notificacion {
            position: fixed;
            top: 20px;
            right: 20px;
            background-color: #1f2937;
            color: white;
            padding: 15px 25px;
            border-radius: 8px;
            box-shadow: 0px 4px 10px rgba(0,0,0,0.3);
            font-weight: 500;
            z-index: 9999;
            opacity: 0;
            transform: translateY(-20px);
            transition: all 0.3s ease-in-out;
            pointer-events: none;
        }

            #notificacion.mostrar {
                opacity: 1;
                transform: translateY(0);
            }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
        <div id="toastCarrito" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fw-semibold">
                    ¡Producto añadido al carrito!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <%# Padding para que el contenido no quede debajo de la navbar fija %>
    <div style="padding-top: 70px;">
        <main role="main" class="pb-3">
            <%- body %>
        </main>
    </div>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="/js/site.js"></script>

    <script>
        // Añadir al carrito desde cualquier tarjeta de producto
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const productoId = this.dataset.productoId;
                    const cantidad = Number(this.dataset.cantidad || 1);

                    fetch('/carrito/agregar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productoId, cantidad })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                mostrarToast();
                                actualizarBadge(data.itemCount);
                            } else {
                                alert(data.message);
                            }
                        })
                        .catch(error => {
                            console.error(error);
                            alert('Error al añadir al carrito.');
                        });
                });
            });

            function mostrarToast() {
                const toastEl = document.getElementById('toastCarrito');
                if (toastEl) new bootstrap.Toast(toastEl).show();
            }
        });

        // Contador del carrito en la navbar
        function actualizarBadge(cantidad) {
            const badge = document.getElementById('cart-badge');
            if (!badge) return;
            badge.textContent = cantidad;
            badge.style.display = cantidad > 0 ? 'inline-block' : 'none';
        }

        window.updateCartCount = function () {
            fetch('/carrito/contador')
                .then(r => r.json())
                .then(d => actualizarBadge(d.itemCount))
                .catch(() => { });
        };

        document.addEventListener('DOMContentLoaded', window.updateCartCount);
    </script>

    <%# Animaciones por scroll (IntersectionObserver) %>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const delay = entry.target.dataset.delay || 0;
                        setTimeout(() => entry.target.classList.add("is-visible"), parseInt(delay));
                        obs.unobserve(entry.target);
                    }
                });
            }, { root: null, rootMargin: "0px", threshold: 0.1 });

            document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
        });
    </script>
</body>
</html>
