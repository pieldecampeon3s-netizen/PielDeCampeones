<%#
  Layout principal — equivalente a Views/Shared/_Layout.cshtml del proyecto .NET.
  Locals que espera:
    title    (string)        título de la pestaña
    usuario  (objeto|null)   { nombre, email, esAdmin } — null si no hay sesión
  El contenido de cada página se inyecta en la variable "body".
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' && title ? title : 'Piel de Campeón' %></title>

    <%#
      Iconos. El SVG lo prefieren los navegadores modernos (nítido a cualquier
      tamaño y una sola descarga); el .ico queda para los antiguos y para la
      barra de tareas de Windows.
    %>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <%# Tiñe la barra del navegador en Android para que no corte con la página. %>
    <meta name="theme-color" content="#0d0d0d" />
    <%#
      Librerías servidas por el propio servidor (ver /vendor en server.js).
      Antes venían de cdn.jsdelivr.net, unpkg.com y fonts.googleapis.com: en
      redes móviles que no alcanzan esos dominios la tienda se quedaba sin
      estilos, sin menú plegable y sin toasts.
    %>
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/vendor/aos/aos.css" />
    <link rel="stylesheet" href="/css/fuentes.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/componentes.css" />
    <link rel="stylesheet" href="/css/barra-inferior.css" />

    <%# Hojas propias de la página, si la ruta las pide (p. ej. el catálogo). %>
    <% (typeof estilos !== 'undefined' ? estilos : []).forEach(function (hoja) { %>
        <link rel="stylesheet" href="<%= hoja %>" />
    <% }); %>

    <%# Ajustes de móvil: va el último para poder sobreescribir a Bootstrap y a site.css %>
    <link rel="stylesheet" href="/css/movil.css" />

    <style>
        .animate-on-scroll {
            opacity: 0;
            transition: opacity 1s cubic-bezier(0.23, 1, 0.32, 1), transform 1s cubic-bezier(0.23, 1, 0.32, 1);
        }

            .animate-on-scroll[data-animation="fade-up"] {
                transform: translateY(50px);
            }

            .animate-on-scroll[data-animation="zoom-in"] {
                transform: scale(0.95);
            }

            .animate-on-scroll.is-visible {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

        /*
          El contenedor del toast es fijo y con padding, así que sigue
          interceptando clics en su esquina aunque el toast esté oculto: justo
          encima de los botones "Añadir al carrito" de la última tarjeta.
          Solo el toast visible debe recibir toques.
        */
        .toast-container {
            pointer-events: none;
        }

            .toast-container .toast {
                pointer-events: auto;
            }

        #notificacion {
            position: fixed;
            top: 20px;
            right: 20px;
            background-color: #1f2937;
            color: white;
            padding: 15px 25px;
            border-radius: 8px;
            box-shadow: 0px 4px 10px rgba(0,0,0,0.3);
            font-weight: 500;
            z-index: 9999;
            opacity: 0;
            transform: translateY(-20px);
            transition: all 0.3s ease-in-out;
            pointer-events: none;
        }

            #notificacion.mostrar {
                opacity: 1;
                transform: translateY(0);
            }
    </style>
</head>
<body class="<%= typeof cuerpoClase !== 'undefined' ? cuerpoClase : '' %>"
      data-pagina="<%= typeof pagina !== 'undefined' ? pagina : '' %>">
    <%#
      Páginas de pago: sin navbar ni footer. Menos distracciones en el paso
      donde el cliente decide, que es la práctica habitual en tiendas.
      Aun así pasan por este layout para no volver a depender de CDN externos.
    %>
    <% if (typeof soloContenido === 'undefined' || !soloContenido) { %>
        <%- include('../partials/navbar') %>
    <% } %>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
        <div id="toastCarrito" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fw-semibold">
                    ¡Producto añadido al carrito!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <%# El padding compensa la navbar fija; sin navbar no hace falta. %>
    <div style="padding-top: <%= typeof soloContenido !== 'undefined' && soloContenido ? '0' : '70px' %>;">
        <main role="main" class="pb-3">
            <%- body %>
        </main>
    </div>

    <% if (typeof soloContenido === 'undefined' || !soloContenido) { %>
        <%- include('../partials/footer') %>
        <%- include('../partials/barra-inferior') %>
    <% } %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/vendor/aos/aos.js"></script>
    <script src="/js/site.js"></script>
    <%# Los favoritos van aparte y en todas las páginas: la tarjeta de producto
        se pinta en el catálogo, en /favoritos y donde haga falta. %>
    <script src="/js/favoritos.js" defer></script>

    <%# Scripts propios de la página, si la ruta los pide. %>
    <% (typeof scripts !== 'undefined' ? scripts : []).forEach(function (archivo) { %>
        <script src="<%= archivo %>" defer></script>
    <% }); %>

    <script>
        // Añadir al carrito desde cualquier tarjeta de producto
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const productoId = this.dataset.productoId;
                    const cantidad = Number(this.dataset.cantidad || 1);

                    fetch('/carrito/agregar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productoId, cantidad })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                mostrarToast();
                                actualizarBadge(data.itemCount);
                            } else {
                                alert(data.message);
                            }
                        })
                        .catch(error => {
                            console.error(error);
                            alert('Error al añadir al carrito.');
                        });
                });
            });

            function mostrarToast() {
                const toastEl = document.getElementById('toastCarrito');
                if (toastEl) new bootstrap.Toast(toastEl).show();
            }
        });

        // Contador del carrito: hay dos, el de la navbar (escritorio) y el de
        // la barra inferior (móvil). Se actualizan los dos a la vez.
        function actualizarBadge(cantidad) {
            ['cart-badge', 'cart-badge-movil'].forEach(function (id) {
                const badge = document.getElementById(id);
                if (!badge) return;
                badge.textContent = cantidad;
                badge.style.display = cantidad > 0 ? 'inline-flex' : 'none';
            });
        }

        window.updateCartCount = function () {
            fetch('/carrito/contador')
                .then(r => r.json())
                .then(d => actualizarBadge(d.itemCount))
                .catch(() => { });
        };

        document.addEventListener('DOMContentLoaded', window.updateCartCount);
    </script>

    <%# Animaciones por scroll (IntersectionObserver) %>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const delay = entry.target.dataset.delay || 0;
                        setTimeout(() => entry.target.classList.add("is-visible"), parseInt(delay));
                        obs.unobserve(entry.target);
                    }
                });
            }, { root: null, rootMargin: "0px", threshold: 0.1 });

            document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
        });
    </script>
</body>
</html>
