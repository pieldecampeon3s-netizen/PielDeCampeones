<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - Piel de Campeón</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --color-primario: #d90429;
            --color-texto-principal: #f5f5f7;
            --color-texto-secundario: #a8a8a8;
        }

        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
        }

        .auth-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-image: linear-gradient(rgba(18, 18, 18, 0.85), rgba(18, 18, 18, 0.95)), url('/images/hero-main-bg.jpg');
            background-size: cover;
            background-position: center;
            padding: 2rem;
        }

        .auth-card {
            max-width: 450px;
            width: 100%;
            background: rgba(30, 30, 30, 0.75);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1.5rem;
            padding: 2.5rem;
            color: var(--color-texto-principal);
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        }

            .auth-card h2 {
                font-weight: 800;
            }

            .auth-card .form-floating > .form-control {
                background-color: rgba(255, 255, 255, 0.05);
                border-color: rgba(255, 255, 255, 0.2);
                color: #fff;
            }

                .auth-card .form-floating > .form-control:focus {
                    background-color: rgba(255, 255, 255, 0.1);
                    border-color: var(--color-primario);
                    box-shadow: none;
                }

            .auth-card .form-floating > label {
                color: var(--color-texto-secundario);
            }

            .auth-card .btn-primary {
                background-color: var(--color-primario);
                border: none;
                font-weight: 600;
                padding: 0.75rem;
                border-radius: 0.5rem;
                transition: background-color 0.2s ease;
            }

                .auth-card .btn-primary:hover {
                    background-color: #b80322;
                }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="text-center mb-4">
                <h2 class="fw-bold"><%= title %></h2>
                <p class="text-white-50">Crea tu nueva contraseña segura.</p>
            </div>

            <section>
                <form method="post">
                    <div class="text-danger mb-3" role="alert"></div>
                    <%# Campo oculto para enviar el código de reseteo %>
                    <input name="code" id="code" type="hidden" />

                    <div class="form-floating mb-3">
                        <input name="password" id="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nueva contraseña" />
                        <label for="password" class="form-label"></label>
                        <span class="text-danger"><%= (errores && errores.password) || '' %></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="confirmPassword" id="confirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirmar nueva contraseña" />
                        <label for="confirmPassword" class="form-label"></label>
                        <span class="text-danger"><%= (errores && errores.confirmPassword) || '' %></span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">Restablecer Contraseña</button>
                    </div>
                </form>
            </section>
        </div>
    </div>


</body>
</html>
