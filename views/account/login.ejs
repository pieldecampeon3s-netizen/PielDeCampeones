<%#
  Inicio de sesión. Dos paneles: la marca a la izquierda y el formulario a la
  derecha. En móvil se apilan, con el panel de marca reducido para que el
  formulario se vea sin hacer scroll.

  Antes esta vista traía su propio <html> y cargaba Bootstrap desde un CDN;
  ahora pasa por el layout con `soloContenido`, que le da las librerías locales
  sin navbar ni pie.

  OJO: todavía no hay autenticación real. El formulario envía a
  POST /account/login, que hoy solo responde con un aviso. Cuando conectes
  Supabase Auth, esa ruta es el único sitio que hay que tocar.

  Espera (opcionales): aviso, valores
%>
<div class="login-pagina">
    <div class="login-tarjeta">

        <%# --- Panel de marca --- %>
        <aside class="login-marca">
            <div class="login-marca-fondo" aria-hidden="true"></div>

            <div class="login-marca-contenido">
                <%# Corona dibujada a mano: el icono de Bootstrap más parecido
                    es una medalla, y en el diseño es una corona de verdad. %>
                <svg class="login-corona" viewBox="0 0 64 44" aria-hidden="true" focusable="false">
                    <path d="M4 40h56l-4-28-14 10L32 4 18 22 6 12z" />
                    <circle cx="4" cy="10" r="4" />
                    <circle cx="32" cy="2" r="4" />
                    <circle cx="60" cy="10" r="4" />
                </svg>

                <h1 class="login-bienvenida">
                    Bienvenido a
                    <span>Piel de Campeón</span>
                </h1>

                <p class="login-lema">
                    Tu tienda oficial de camisetas<br>
                    de los mejores clubes del mundo
                </p>

                <ul class="login-garantias">
                    <li>
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <strong>Compra segura</strong>
                        <small>Protegemos tus datos</small>
                    </li>
                    <li>
                        <i class="bi bi-patch-check" aria-hidden="true"></i>
                        <strong>Productos oficiales</strong>
                        <small>Calidad garantizada</small>
                    </li>
                    <li>
                        <i class="bi bi-headset" aria-hidden="true"></i>
                        <strong>Atención 24/7</strong>
                        <small>Estamos para ti</small>
                    </li>
                </ul>
            </div>
        </aside>

        <%# --- Formulario --- %>
        <main class="login-panel">

            <span class="login-emblema" aria-hidden="true">
                <i class="bi bi-person-badge"></i>
            </span>

            <h2 class="login-titulo">Iniciar sesión</h2>
            <p class="login-subtitulo">Utiliza tu cuenta para continuar</p>

            <% if (typeof aviso !== 'undefined' && aviso) { %>
                <p class="login-aviso" role="status">
                    <i class="bi bi-info-circle-fill"></i> <%= aviso %>
                </p>
            <% } %>

            <form action="/account/login" method="post" id="formLogin" novalidate>

                <div class="login-campo">
                    <label for="email">Correo electrónico</label>
                    <div class="login-caja">
                        <span class="login-icono"><i class="bi bi-envelope"></i></span>
                        <input type="email"
                               id="email"
                               name="email"
                               placeholder="ejemplo@correo.com"
                               autocomplete="username"
                               value="<%= (typeof valores !== 'undefined' && valores.email) || '' %>"
                               required>

                        <%# Visto dorado: aparece solo cuando el correo está
                            bien escrito. Va después del input para que el CSS
                            pueda reaccionar a su validez. %>
                        <span class="login-valido" aria-hidden="true">
                            <i class="bi bi-check-circle"></i>
                        </span>
                    </div>
                    <p class="login-error" data-error-de="email"></p>
                </div>

                <div class="login-campo">
                    <label for="password">Contraseña</label>
                    <div class="login-caja">
                        <span class="login-icono"><i class="bi bi-lock"></i></span>
                        <input type="password"
                               id="password"
                               name="password"
                               placeholder="••••••••"
                               autocomplete="current-password"
                               required>
                        <button type="button"
                                class="login-ver-clave"
                                id="verClave"
                                aria-label="Mostrar la contraseña"
                                aria-pressed="false">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>
                    <p class="login-error" data-error-de="password"></p>
                </div>

                <div class="login-fila">
                    <div class="form-check login-recuerdame">
                        <input class="form-check-input"
                               type="checkbox"
                               id="rememberMe"
                               name="rememberMe"
                               value="1">
                        <label class="form-check-label" for="rememberMe">Recuérdame</label>
                    </div>

                    <a href="/account/recuperar" class="login-olvide">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="login-entrar">
                    Ingresar
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </form>

            <p class="login-registro">
                ¿No tienes una cuenta?
                <a href="/account/registro">Crear cuenta</a>
            </p>

            <a href="/" class="login-volver">
                <i class="bi bi-chevron-left"></i> Volver a la tienda
            </a>
        </main>
    </div>
</div>
