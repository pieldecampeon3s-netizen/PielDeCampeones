<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - Piel de Campeón</title>

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0d0d0d" />


    <!-- Librerías de Estilos -->
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/fuentes.css" />
    <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css" />

    <!-- Estilos Personalizados (Compartidos con el Login) -->
    <style>
        :root {
            --color-primario: #d9b04a;
            --color-texto-principal: #f5f5f7;
            --color-texto-secundario: #a8a8a8;
        }

        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
        }

        .auth-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            /* La imagen original (hero-main-bg.jpg) no existe. Se reutiliza la
               foto de la tienda: el JPG para navegadores antiguos y, debajo,
               la versión WebP que pesa la cuarta parte. */
            background-image: linear-gradient(rgba(18, 18, 18, 0.85), rgba(18, 18, 18, 0.95)), url('/images/futbol.jpg');
            background-image: linear-gradient(rgba(18, 18, 18, 0.85), rgba(18, 18, 18, 0.95)),
                              image-set(url('/images/futbol-1280.webp') type('image/webp'),
                                        url('/images/futbol.jpg') type('image/jpeg'));
            background-size: cover;
            background-position: center;
            padding: 2rem;
        }

        .auth-card {
            max-width: 450px;
            width: 100%;
            background: rgba(30, 30, 30, 0.75);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1.5rem;
            padding: 2.5rem;
            color: var(--color-texto-principal);
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        }

        .auth-card h2 {
            font-weight: 800;
        }

        .auth-card .form-floating > .form-control {
            background-color: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.2);
            color: #fff;
        }
        .auth-card .form-floating > .form-control:focus {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: var(--color-primario);
            box-shadow: none;
        }
        .auth-card .form-floating > label {
            color: var(--color-texto-secundario);
        }

        .auth-card .btn-primary {
            background-color: var(--color-primario);
            border: none;
            font-weight: 600;
            padding: 0.75rem;
            border-radius: 0.5rem;
            transition: background-color 0.2s ease;
        }
        .auth-card .btn-primary:hover {
            background-color: #b80322;
        }

        .auth-card .small-links a {
            color: var(--color-texto-secundario);
            text-decoration: none;
            transition: color 0.2s ease;
        }
        .auth-card .small-links a:hover {
            color: #fff;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="text-center mb-4">
                <h2 class="fw-bold">Crea tu Cuenta</h2>
                <p class="text-white-50">Únete a la comunidad de Piel de Campeón</p>
            </div>

            <section>
                <form action="/account/registro" method="post">
                    <div class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input name="email" id="email" class="form-control" autocomplete="email" aria-required="true" placeholder="nombre@ejemplo.com" />
                        <label for="email" class="form-label"></label>
                        <span class="text-danger"><%= (errores && errores.email) || '' %></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="password" id="password" class="form-control" type="password" autocomplete="new-password" aria-required="true" placeholder="contraseña" />
                        <label for="password" class="form-label"></label>
                        <span class="text-danger"><%= (errores && errores.password) || '' %></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="confirmPassword" id="confirmPassword" class="form-control" type="password" autocomplete="new-password" aria-required="true" placeholder="confirmar contraseña" />
                        <label for="confirmPassword" class="form-label"></label>
                        <span class="text-danger"><%= (errores && errores.confirmPassword) || '' %></span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">Registrarme</button>
                    </div>

                    <div class="text-center mt-4 small-links">
                        <a href="/account/login">¿Ya tienes una cuenta? Inicia Sesión</a>
                    </div>
                </form>
            </section>
        </div>
    </div>    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
